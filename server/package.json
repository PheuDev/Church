  "private": true,
  "description": "API backend — AD Gestion",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "test": "cross-env NODE_ENV=test DATABASE_URL=postgresql://church_app:church_dev_2026@localhost:5432/church_test_db node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
