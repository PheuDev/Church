# ============================================================
# AD Gestion — Variables d'environnement serveur
# Copiez ce fichier en .env et renseignez les valeurs réelles.
# NE JAMAIS committer le fichier .env !
# ============================================================

# ── Base de données PostgreSQL ────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://church_app:CHANGE_ME@localhost:5432/church_db

# ── JWT ───────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── Serveur ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────
# URL(s) du frontend — séparer plusieurs origines par des virgules
CLIENT_ORIGIN=https://votre-domaine.com

# ── Uploads ──────────────────────────────────────────────────
# Chemin absolu ou relatif depuis server/ — créé automatiquement
UPLOAD_DIR=storage/uploads
