// ============================================================
// AD GESTION — Schéma Prisma (PostgreSQL)
// Modèle de données V1 — Gestion opérationnelle d'une église
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMÉRATIONS
// ============================================================

// Sexe
enum Gender {
  MALE
  FEMALE
}

// Statut d'une personne dans l'église
enum PersonStatus {
  MEMBER // Membre
  ATTENDEE // Fidèle / participant régulier
  CANDIDATE // Candidat (au baptême / à la formation)
  VISITOR // Visiteur
  FORMER // Ancien membre
  DECEASED // Décédé
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// Rôles applicatifs des utilisateurs (V1)
enum UserRole {
  ADMIN // Administrateur de l'église
  PASTOR // Pasteur
  SECRETARY // Secrétaire
  TREASURER // Trésorier
  VIEWER // Consultation seule
}

// Types de départements internes
enum DepartmentType {
  MEN
  WOMEN
  YOUTH
  TEENAGERS
  CHILDREN
  PRAYER
  WORSHIP
  EDUCATION
  MUSIC
  OTHER
}

enum DepartmentMemberRole {
  LEADER
  ASSISTANT
  TREASURER
  SECRETARY
  MEMBER
}

enum ActivityStatus {
  PLANNED
  ONGOING
  DONE
  CANCELLED
}

// Type de séance (Leçon ≠ Séance)
enum SeanceType {
  NEW_LESSON // Nouvelle leçon
  SUITE // Suite
  REVISION // Révision
  RAPPEL // Rappel
  EVALUATION // Évaluation
  SYNTHESE // Synthèse
  AUTRE // Autre
}

enum FormationStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

// Mode de notation des évaluations
enum GradingMode {
  PERCENT // Note en pourcentage (ex. 80 %)
  SCORE_20 // Note sur 20
  SCORE_100 // Note sur 100
}

// Parcours d'un candidat au baptême
enum CandidateStatus {
  ENROLLED // Inscrit
  IN_FORMATION // Formation suivie
  EVALUATED // Évalué
  VALIDATED // Validé (réussite)
  APPROVED // Décision de baptême
  BAPTIZED // Baptême effectué
  WITHDRAWN // Retiré
  DEFERRED // Reporté
}

enum AccountType {
  CASH
  BANK
  MOBILE_MONEY
}

enum RevenueSource {
  QUETE // Quête
  OFFER // Offrande
  TITHE // Dîme
  CONTRIBUTION // Cotisation
  DONATION // Don
  EVENT // Recette d'événement
  PROJECT // Recette de projet
  OTHER // Autre
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  IN_KIND
}

// Périodicité d'une cotisation
enum Periodicity {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum EngagementStatus {
  OPEN // En cours
  PARTIAL // Partiellement honoré
  FULFILLED // Honoré
  CANCELLED // Annulé / inactif
}

enum EventType {
  FETE
  DEPT_DAY
  OUTING
  CONFERENCE
  CAMPAIGN
  RETREAT
  OTHER
}

enum ProjectType {
  CONSTRUCTION
  RENOVATION
  EQUIPMENT
  EVANGELIZATION
  SOCIAL
  OTHER
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  HALTED
}

enum CertificateType {
  BAPTISM
  MEMBERSHIP
  CONFIRMATION
  COURSE
  ATTENDANCE
}

// ============================================================
// ÉGLISE (entité réellement gérée)
// ============================================================

model Church {
  id          String   @id @default(cuid())
  name        String   // Nom officiel
  shortName   String?  // Nom court / sigle
  code        String   @unique // Code interne
  address     String?
  city        String?
  phone       String?
  email       String?
  website     String?
  foundedAt   DateTime?
  pastorName  String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings      ChurchSetting[]
  users         User[]
  persons       Person[]
  departments   Department[]
  departmentMembers DepartmentMember[]
  activityTypes ActivityType[]
  activities    Activity[]
  attendanceStats AttendanceStat[]
  ssClasses     SundaySchoolClass[]
  ssSessions    SundaySchoolSession[]
  sundayServices SundayService[]
  baptismSessions BaptismSession[]
  programs      FormationProgram[]
  formationSessions FormationSession[]
  lessons       Lesson[]
  sessionLessons SessionLesson[]
  candidates    BaptismCandidate[]
  candidateAttendances CandidateAttendance[]
  evaluations   Evaluation[]
  baptisms      Baptism[]
  certificates  Certificate[]
  accounts      Account[]
  finCategories FinancialCategory[]
  revenues      Revenue[]
  expenses      Expense[]
  engagements   Engagement[]
  engagementPayments EngagementPayment[]
  events        ChurchEvent[]
  eventParticipants EventParticipant[]
  projects      Project[]
  documents     Document[]
  auditLogs     AuditLog[]
}

// Paramètres clé/valeur d'une église (configuration)
model ChurchSetting {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  key       String   // ex: certificateInstitutionName, gradingMode, ...
  value     Json     // valeur (texte, nombre, objet)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, key])
}

// ============================================================
// UTILISATEURS
// ============================================================

model User {
  id                String    @id @default(cuid())
  churchId          String
  church            Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  email             String
  fullName          String
  username          String?
  role              UserRole  @default(VIEWER)
  passwordHash      String
  phone             String?
  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  tokenVersion      Int       @default(0) // incrémenté pour invalider les jetons
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditLogs       AuditLog[]
  createdRevenues Revenue[]       @relation("RevenueCreatedBy")
  createdExpenses Expense[]       @relation("ExpenseCreatedBy")
  createdDocs     Document[]      @relation("DocumentCreatedBy")
  receivedEngagementPayments EngagementPayment[] @relation("PaymentReceivedBy")

  @@unique([churchId, email])
  @@index([churchId])
}

// ============================================================
// PERSONNES
// ============================================================

model Person {
  id            String        @id @default(cuid())
  churchId      String
  church        Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  gender        Gender?
  birthDate     DateTime?
  birthPlace    String?
  phone         String?
  phoneAlt      String?
  email         String?
  address       String?
  maritalStatus MaritalStatus?
  profession    String?
  status        PersonStatus  @default(ATTENDEE)
  memberSince   DateTime?
  membershipNumber String?
  photoKey      String?
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  departmentMemberships DepartmentMember[]
  candidateRecords      BaptismCandidate[]
  baptisms              Baptism[]
  certificates          Certificate[]
  ledDepartments        Department[]  @relation("DepartmentLeader")
  ledActivities         Activity[]    @relation("ActivityResponsible")
  taughtSsSessions      SundaySchoolSession[] @relation("SSSessionTeacher")
  taughtSsClasses       SundaySchoolClass[]   @relation("SSClassTeacher")
  ledFormationSessions  FormationSession[]    @relation("FormationSessionResponsible")
  taughtSessionLessons  SessionLesson[]       @relation("SessionLessonTeacher")
  paidRevenues          Revenue[]             @relation("RevenuePayer")
  eventRoles            EventParticipant[]
  ledEvents             ChurchEvent[]         @relation("EventResponsible")
  ledProjects           Project[]             @relation("ProjectResponsible")
  engagements           Engagement[]          @relation("EngagementPerson")
  engagementPayments    EngagementPayment[]   @relation("EngagementPersonPaid")
  evaluationsGiven      Evaluation[]          @relation("EvaluationEvaluator")
  officiatedBaptisms    Baptism[]             @relation("BaptismOfficiant")
  documents             Document[]            @relation("DocumentPerson")
  sundayServicesPreached SundayService[]      @relation("ServicePreacher")
  sundayServicesMC       SundayService[]      @relation("ServiceMC")

  @@index([churchId])
  @@index([lastName, firstName])
  @@index([phone])
}

// ============================================================
// DÉPARTEMENTS INTERNES
// ============================================================

model Department {
  id               String         @id @default(cuid())
  churchId         String
  church           Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name             String
  type             DepartmentType @default(OTHER)
  leaderPersonId   String?
  leader           Person?        @relation("DepartmentLeader", fields: [leaderPersonId], references: [id], onDelete: SetNull)
  color            String?
  description      String?
  isActive         Boolean        @default(true)
  // Effectif saisi manuellement (remplace le comptage via DepartmentMember)
  headcount        Int?           // Effectif total renseigné
  headcountMale    Int?           // Dont hommes
  headcountFemale  Int?           // Dont femmes
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  members      DepartmentMember[]
  engagements  Engagement[]

  @@index([churchId])
  @@unique([churchId, name])
}

// Membre identifié d'un département
model DepartmentMember {
  id           String             @id @default(cuid())
  churchId     String
  church       Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  personId     String
  person       Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  role         DepartmentMemberRole @default(MEMBER)
  joinedAt     DateTime?
  isActive     Boolean            @default(true)
  notes        String?
  createdAt    DateTime           @default(now())

  @@unique([departmentId, personId])
  @@index([churchId])
}

// ============================================================
// ACTIVITÉS & PRÉSENCES
// ============================================================

model ActivityType {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  icon        String?  // nom d'icône (lucide)
  color       String?
  defaultDurationMin Int?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  activities Activity[]

  @@unique([churchId, name])
  @@index([churchId])
}

model Activity {
  id                 String       @id @default(cuid())
  churchId           String
  church             Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  typeId             String
  type               ActivityType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  title              String
  activityDate       DateTime     @db.Date
  startTime          String?      // "09:00"
  endTime            String?
  location           String?
  responsibleId      String?
  responsible        Person?      @relation("ActivityResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  description        String?
  status             ActivityStatus @default(PLANNED)
  reportNote         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  attendanceStats   AttendanceStat[]

  @@index([churchId, activityDate])
  @@index([churchId, typeId])
}

// Présences — mode quantitatif (compteurs saisis + observations)
model AttendanceStat {
  id            String   @id @default(cuid())
  churchId      String
  church        Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  activityId    String   @unique
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  presentCount  Int      @default(0)
  absentCount   Int      @default(0)
  excusedCount  Int      @default(0)
  lateCount     Int      @default(0)
  visitorCount  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([churchId])
}

// ============================================================
// FINANCES — Catégories (recette / dépense)
// ============================================================

enum FinancialCategoryKind {
  INCOME
  EXPENSE
}

// ============================================================
// ÉCOLE DU DIMANCHE
// ============================================================

model SundaySchoolClass {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  teacherId   String?
  teacher     Person?   @relation("SSClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  minAge      Int?
  maxAge      Int?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions SundaySchoolSession[] @relation("SSSessionClass")

  @@index([churchId])
  @@unique([churchId, name])
}

model SundaySchoolSession {
  id          String               @id @default(cuid())
  churchId    String
  church      Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  classId     String
  class       SundaySchoolClass    @relation("SSSessionClass", fields: [classId], references: [id], onDelete: Cascade)
  title       String
  sessionDate DateTime             @db.Date
  teacherId   String?
  teacher     Person?              @relation("SSSessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  lessonTopic String?
  notes       String?
  status      ActivityStatus       @default(DONE)
  // Effectif & suivi
  presentCount Int     @default(0)
  absentCount  Int     @default(0)
  bibleCount   Int     @default(0)   // Bibles apportées
  offering     Decimal @default(0)   // Offrande de la classe
  attendanceNotes String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([churchId, sessionDate])
  @@index([churchId, classId])
}

// Culte du dimanche — service principal (offrandes, MC, prédicateur)
model SundayService {
  id             String    @id @default(cuid())
  churchId       String
  church         Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  serviceDate    DateTime  @db.Date
  mcPersonId     String?
  mc             Person?   @relation("ServiceMC", fields: [mcPersonId], references: [id], onDelete: SetNull)
  preacherId     String?
  preacher       Person?   @relation("ServicePreacher", fields: [preacherId], references: [id], onDelete: SetNull)
  theme          String?
  offering       Decimal   @default(0)
  specialOffering Decimal  @default(0)
  eventId        String?
  event          ChurchEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([churchId, serviceDate])
}

// Session de baptême (promotion / cohorte)
model BaptismSession {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String    // ex: "Juin 2026"
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  status      ActivityStatus @default(ONGOING)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidates  BaptismCandidate[]

  @@index([churchId])
}

// ============================================================
// FORMATIONS (programmes, sessions, leçons)
// ============================================================

model FormationProgram {
  id            String        @id @default(cuid())
  churchId      String
  church        Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  gradingMode   GradingMode   @default(PERCENT)
  passThreshold Int           @default(70)
  totalLessons  Int?
  durationWeeks Int?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sessions FormationSession[]
  lessons  Lesson[]

  @@index([churchId])
  @@unique([churchId, name])
}

model FormationSession {
  id            String           @id @default(cuid())
  churchId      String
  church        Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  programId     String
  program       FormationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime?
  endDate       DateTime?
  status        FormationStatus  @default(PLANNED)
  responsibleId String?
  responsible   Person?          @relation("FormationSessionResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  location      String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lessonPlans SessionLesson[]

  @@index([churchId, programId])
}

model Lesson {
  id           String           @id @default(cuid())
  churchId     String
  church       Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  programId    String
  program      FormationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  title        String
  number       Int?
  objective    String?
  content      String?
  durationMin  Int?
  verses       String?  // Références bibliques (ex: "Jean 3:16 ; Matthieu 28:19")
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sessionTeachings  SessionLesson[]

  @@index([churchId, programId])
}

model SessionLesson {
  id         String           @id @default(cuid())
  churchId   String
  church     Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sessionId  String
  session    FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  seanceType SeanceType       @default(NEW_LESSON)
  title      String
  taughtAt   DateTime?        @db.Date
  teacherId  String?
  teacher    Person?          @relation("SessionLessonTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  objective  String?
  content    String?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([churchId, sessionId])
}

// ============================================================
// BAPTÊMES & CERTIFICATS
// ============================================================

model BaptismCandidate {
  id                 String            @id @default(cuid())
  churchId           String
  church             Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId           String
  person             Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  baptismSessionId   String?
  baptismSession     BaptismSession?   @relation(fields: [baptismSessionId], references: [id], onDelete: SetNull)
  status             CandidateStatus   @default(ENROLLED)
  enrolledAt         DateTime?         @db.Date
  requestedAt        DateTime?
  approvedAt         DateTime?
  // Suivi pédagogique
  subscriptionAmount Decimal?          // Montant de souscription
  subscriptionPaid   Boolean           @default(false)
  grade              Int?              // Note d'évaluation
  gradingMode        GradingMode       @default(PERCENT)
  evalPassed         Boolean?
  evalComments       String?
  evalDate           DateTime?         @db.Date
  // Documents
  hasIdPhoto         Boolean           @default(false)
  idPhotoKey         String?           // Clé fichier photo d'identité (storage)
  hasBirthCertificate Boolean          @default(false)
  birthCertificateKey String?          // Clé fichier acte de naissance (storage)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  evaluations Evaluation[]
  baptism     Baptism?
  attendances CandidateAttendance[]

  @@index([churchId, status])
  @@index([churchId, personId])
  @@index([churchId, baptismSessionId])
}

// Présence d'un candidat chaque dimanche pendant la session de baptême
model CandidateAttendance {
  id          String           @id @default(cuid())
  churchId    String
  church      Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   BaptismCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attendDate  DateTime         @db.Date
  present     Boolean          @default(false)
  excused     Boolean          @default(false)  // permissionnaire
  biblePresent Boolean         @default(false)
  notes       String?
  createdAt   DateTime         @default(now())

  @@unique([candidateId, attendDate])
  @@index([churchId, attendDate])
}

model Evaluation {
  id          String            @id @default(cuid())
  churchId    String
  church      Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   BaptismCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evaluatorId String?
  evaluator   Person?           @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  grade       Int               @default(0)
  gradingMode GradingMode       @default(PERCENT)
  passed      Boolean?
  comments    String?
  evaluatedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([churchId, candidateId])
}

model Baptism {
  id          String               @id @default(cuid())
  churchId    String
  church      Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId    String
  person      Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  candidateId String?              @unique
  candidate   BaptismCandidate?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  baptismDate DateTime             @db.Date
  officiantId String?
  officiant   Person?              @relation("BaptismOfficiant", fields: [officiantId], references: [id], onDelete: SetNull)
  location    String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  certificate Certificate?

  @@index([churchId, baptismDate])
  @@index([churchId, personId])
}

model Certificate {
  id              String          @id @default(cuid())
  churchId        String
  church          Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId        String
  person          Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  type            CertificateType
  title           String?
  referenceNumber String?
  issuedAt        DateTime?
  baptismId       String?         @unique
  baptism         Baptism?        @relation(fields: [baptismId], references: [id], onDelete: SetNull)
  content         Json?
  fileKey         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([churchId, type])
  @@index([churchId, personId])
}

// ============================================================
// FINANCES (comptes, catégories, recettes, dépenses, engagements)
// ============================================================

model Account {
  id             String      @id @default(cuid())
  churchId       String
  church         Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(CASH)
  purpose        Json?       // Tableau de RevenueSource associées à ce compte (ex: ["OFFER","QUETE"])
  accountNumber  String?
  bankName       String?
  phoneNumber    String?
  currency       String      @default("XAF")
  initialBalance Decimal     @default(0)
  description    String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  revenues Revenue[]
  expenses Expense[]

  @@index([churchId])
  @@unique([churchId, name])
}

model FinancialCategory {
  id          String                @id @default(cuid())
  churchId    String
  church      Church                @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  kind        FinancialCategoryKind @default(INCOME)
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  revenues Revenue[] @relation("RevenueCategory")
  expenses Expense[] @relation("ExpenseCategory")

  @@index([churchId])
  @@unique([churchId, name, kind])
}

model Revenue {
  id            String              @id @default(cuid())
  churchId      String
  church        Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      FinancialCategory?  @relation("RevenueCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  source        RevenueSource       @default(OTHER)
  description   String
  amount        Decimal
  paymentMethod PaymentMethod       @default(CASH)
  payerId       String?
  payer         Person?             @relation("RevenuePayer", fields: [payerId], references: [id], onDelete: SetNull)
  receivedAt    DateTime
  createdById   String?
  createdBy     User?               @relation("RevenueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  receiptNumber String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([churchId, receivedAt])
  @@index([churchId, source])
  @@index([churchId, accountId])
}

model Expense {
  id            String              @id @default(cuid())
  churchId      String
  church        Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      FinancialCategory?  @relation("ExpenseCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  description   String
  amount        Decimal
  paymentMethod PaymentMethod       @default(CASH)
  beneficiary   String?
  expenseDate   DateTime
  createdById   String?
  createdBy     User?               @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  receiptNumber String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([churchId, expenseDate])
  @@index([churchId, categoryId])
}

// Engagements : cotisations périodiques ET promesses de don (fusionnés)
model Engagement {
  id           String              @id @default(cuid())
  churchId     String
  church       Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId     String?             // Engagement individuel (promesse d'une personne)
  person       Person?             @relation("EngagementPerson", fields: [personId], references: [id], onDelete: Cascade)
  departmentId String?             // Cotisation collective (département)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  amount       Decimal
  periodicity  Periodicity         @default(ONE_TIME)
  periodStart  DateTime?
  periodEnd    DateTime?
  dueDate      DateTime?
  status       EngagementStatus    @default(OPEN)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  payments EngagementPayment[]

  @@index([churchId, status])
  @@index([churchId, personId])
  @@index([churchId, departmentId])
  @@index([churchId, projectId])
}

model EngagementPayment {
  id             String            @id @default(cuid())
  churchId       String
  church         Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  engagementId   String
  engagement     Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  personId       String?           // Bénéficiaire du paiement (ex: cotisant)
  person         Person?           @relation("EngagementPersonPaid", fields: [personId], references: [id], onDelete: Cascade)
  amount         Decimal
  paymentMethod  PaymentMethod     @default(CASH)
  paidAt         DateTime
  periodLabel    String?
  receivedById   String?
  receivedBy     User?             @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([churchId, engagementId])
  @@index([churchId, personId])
}

// ============================================================
// ÉVÉNEMENTS & PROJETS
// ============================================================

model ChurchEvent {
  id            String         @id @default(cuid())
  churchId      String
  church        Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name          String
  type          EventType      @default(OTHER)
  startDate     DateTime       @db.Date
  endDate       DateTime?      @db.Date
  location      String?
  description   String?
  responsibleId String?
  responsible   Person?        @relation("EventResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  budget        Decimal?       @default(0)
  status        ActivityStatus @default(PLANNED)
  reportNote    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  participants EventParticipant[]
  sundayServices SundayService[]

  @@index([churchId, startDate])
  @@index([churchId, type])
}

model EventParticipant {
  id          String      @id @default(cuid())
  churchId    String
  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  eventId     String
  event       ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId    String
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  role        String?
  isConfirmed Boolean     @default(false)
  note        String?
  createdAt   DateTime    @default(now())

  @@unique([eventId, personId])
  @@index([churchId, personId])
}

model Project {
  id            String        @id @default(cuid())
  churchId      String
  church        Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name          String
  type          ProjectType   @default(OTHER)
  description   String?
  status        ProjectStatus @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  targetAmount  Decimal?      @default(0)
  responsibleId String?
  responsible   Person?       @relation("ProjectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  location      String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  engagements Engagement[]
  documents   Document[]

  @@index([churchId, status])
}

// ============================================================
// DOCUMENTS & AUDIT
// ============================================================

model Document {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  description String?
  fileName    String
  fileKey     String
  mimeType    String?
  fileSize    Int?
  personId    String?
  person      Person?  @relation("DocumentPerson", fields: [personId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([churchId, category])
  @@index([churchId, personId])
}

model AuditLog {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([churchId, createdAt])
  @@index([churchId, entity])
}

// ============================================================
// FIN DU SCHÉMA V1
// ============================================================